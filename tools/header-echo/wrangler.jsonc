{
  "name": "chheader-check",
  "main": "worker.js",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": false },
  "limits": { "cpu_ms": 10 },
  "env": { "peer": { "name": "chheader-check-peer" } }
}
