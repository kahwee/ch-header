{
  "name": "ch-header",
  "description": "ChHeader - Profile-based header editor with Manifest V3",
  "version": "0.3.0",
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26.7.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:package": "pnpm run build && pnpm run build:zip",
    "build:zip": "node scripts/build-zip.js",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "dev:extension": "vite build --watch",
    "test:headers": "node scripts/header-check.js"
  },
  "devDependencies": {
    "@storybook/html": "^10.6.0",
    "@storybook/html-vite": "^10.6.0",
    "@types/chrome": "0.2.9",
    "@types/node": "^26.5.1",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "storybook": "^10.6.0",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.1"
  },
  "packageManager": "pnpm@11.25.0"
}
