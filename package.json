{
  "name": "ch-header",
  "license": "MIT",
  "author": "KahWee Teng",
  "description": "Edit request and response headers, organize profiles, and target specific sites to test APIs and websites.",
  "version": "0.4.3",
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26.7.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:package": "pnpm run build && pnpm run build:zip",
    "build:zip": "node scripts/build-zip.js",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "dev:extension": "vite build --watch",
    "test:headers": "node scripts/header-check.js",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:echo && pnpm build:package && pnpm storybook:build",
    "test:workflows": "vitest run src/ui/core/__tests__/profile-workflows.integration.test.ts src/lib/__tests__/profile-transfer.test.ts",
    "test:fast": "vitest run src/ui/core/__tests__/popup-app.integration.test.ts src/ui/core/__tests__/profile-workflows.integration.test.ts src/lib/__tests__/profile-transfer.test.ts src/lib/__tests__/background.test.ts --silent=passed-only",
    "test:fast:watch": "vitest src/ui/core/__tests__/popup-app.integration.test.ts src/ui/core/__tests__/profile-workflows.integration.test.ts src/lib/__tests__/profile-transfer.test.ts src/lib/__tests__/background.test.ts --silent=passed-only",
    "test:echo": "node --test tools/header-echo/worker.test.mjs",
    "test:echo:live": "node --test tools/header-echo/live.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@storybook/html": "^10.6.0",
    "@storybook/html-vite": "^10.6.0",
    "@types/chrome": "0.2.9",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "jsdom": "^30.0.1",
    "storybook": "^10.6.0",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.1"
  },
  "packageManager": "pnpm@12.4.2"
}
