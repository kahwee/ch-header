{
  "name": "ch-header",
  "description": "ChHeader - Profile-based header editor with Manifest V3",
  "version": "0.2.2",
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=25.1.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:package": "pnpm run build && pnpm run build:zip",
    "build:zip": "node scripts/build-zip.js",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest --project browser",
    "test:browser:ui": "vitest --project browser --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "devDependencies": {
    "@storybook/html": "^10.5.10",
    "@storybook/html-vite": "^10.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "0.2.7",
    "@types/node": "^26.4.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@tailwindplus/elements": "^1.0.22"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  }
}
