{
  "manifest_version": 3,
  "name": "ChHeader",
  "description": "Edit request and response headers, organize profiles, and target specific sites to test APIs and websites.",
  "version": "0.4.0",
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "ChHeader"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "128": "icons/128.png"
  },
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "declarative_net_request": {
    "rule_resources": []
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "minimum_chrome_version": "118",
  "offline_enabled": true
}
